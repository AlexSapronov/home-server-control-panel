[Unit]
Description=NERV DPI test worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/home-server-control-panel
ExecStartPre=/usr/bin/python3 /opt/home-server-control-panel/deploy/dpi/namespace.py start /etc/nerv-dpi/worker.json
ExecStart=/usr/bin/python3 /opt/home-server-control-panel/dpi_worker.py worker /etc/nerv-dpi/worker.json
ExecStopPost=/usr/bin/python3 /opt/home-server-control-panel/deploy/dpi/namespace.py stop /etc/nerv-dpi/worker.json
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
PrivateTmp=true
LimitFSIZE=16777216
UMask=0077

[Install]
WantedBy=multi-user.target
