[Unit]
Description=NERV Home Server Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nerv
Group=nerv
WorkingDirectory=/opt/home-server-control-panel
Environment=NERV_CONFIG=/etc/nerv/config.json
EnvironmentFile=/etc/nerv/panel.env
ExecStart=/usr/bin/python3 /opt/home-server-control-panel/server.py --host 127.0.0.1 --port 8080
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
