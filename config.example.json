{
  "mode": "demo",
  "title": "HOME SERVER",
  "proxmox": {
    "url": "https://192.168.10.2:8006",
    "ca_file": "/etc/nerv/pve-root-ca.pem"
  },
  "services": [
    {
      "name": "Proxmox VE",
      "url": "https://192.168.10.2:8006",
      "description": "Гипервизор / VM и контейнеры"
    },
    {
      "name": "OpenWrt",
      "url": "http://192.168.10.1",
      "description": "Маршрутизатор / LuCI"
    },
    {
      "name": "AdGuard Home",
      "url": "http://192.168.10.1:3001",
      "description": "DNS / фильтрация запросов"
    }
  ],
  "openwrt": {
    "enabled": false,
    "host": "192.168.10.1",
    "identity_file": "/etc/nerv/ssh/openwrt_ed25519",
    "known_hosts_file": "/etc/nerv/ssh/known_hosts",
    "adguard_port": 3001,
    "telegram_port": 1443
  },
  "dpi": {
    "enabled": false,
    "db": "/var/lib/nerv-panel/dpi.sqlite3",
    "timezone": "Europe/Moscow",
    "backup_window": [
      "02:45",
      "04:00"
    ],
    "check_interval": 21600,
    "revision_interval": 604800,
    "job_timeout": 3600,
    "series_gap": 120,
    "freshness": 172800,
    "control_url": "https://example.com/",
    "profiles": {
      "youtube": {
        "video_id": "_YOUR_VIDEO",
        "checks": [
          {
            "name": "web-tls13",
            "url": "https://www.youtube.com/",
            "tls": "1.3"
          }
        ]
      },
      "discord": {
        "checks": [
          {
            "name": "web-tls13",
            "url": "https://discord.com/",
            "tls": "1.3",
            "min_bytes": 16384
          }
        ]
      }
    }
  }
}
